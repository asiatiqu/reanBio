# 📌 คัดลอกไฟล์นี้เป็น .env (ไฟล์ .env จะไม่ถูก commit ขึ้น GitHub เพราะอยู่ใน .gitignore แล้ว)
# แล้วใส่ API key จริงของตัวเองแทนค่าด้านล่าง

# สมัคร API key ได้ที่ https://console.anthropic.com/ (เมนู Settings > API Keys)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ไม่บังคับใส่ก็ได้ (ถ้าไม่ใส่จะใช้ค่าเริ่มต้น claude-haiku-4-5)
# เช็กชื่อโมเดลล่าสุดได้ที่ https://docs.claude.com/en/docs/about-claude/models
ANTHROPIC_MODEL=claude-haiku-4-5

# 📌 สำหรับฟีเจอร์ "ลืมรหัสผ่าน" (ส่งอีเมลลิงก์ตั้งรหัสผ่านใหม่) — ถ้าไม่ใส่ EMAIL_HOST ระบบจะพิมพ์อีเมล
# ออกทาง console แทนการส่งจริง (ทดสอบได้ แต่ผู้ใช้จริงจะไม่ได้รับอีเมล)
#
# ตัวอย่างการตั้งค่าด้วย Gmail:
#   1. เปิด 2-Step Verification ที่บัญชี Gmail ก่อน (https://myaccount.google.com/security)
#   2. สร้าง "App Password" ที่ https://myaccount.google.com/apppasswords (ห้ามใช้รหัสผ่าน Gmail ปกติ)
#   3. ใส่ App Password นั้นในช่อง EMAIL_HOST_PASSWORD ด้านล่าง
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=youraccount@gmail.com
EMAIL_HOST_PASSWORD=xxxx-xxxx-xxxx-xxxx
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=reanBio <youraccount@gmail.com>
